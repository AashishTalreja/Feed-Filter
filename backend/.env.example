# Postgres connection (docker-compose sets this automatically for the api service)
DATABASE_URL=postgresql+psycopg2://ycf:ycf@localhost:5432/ycf

# Optional: enables the LLM fallback + RAG stage for videos the embedding
# model isn't confident about. Without this, low-confidence embedding
# guesses are accepted as-is rather than escalated to an LLM.
ANTHROPIC_API_KEY=

# Which embedding model to pull from Hugging Face at startup.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Cosine-similarity threshold below which a video is considered "not
# confident" and gets escalated to the LLM fallback (if configured).
CONFIDENCE_THRESHOLD=0.42
